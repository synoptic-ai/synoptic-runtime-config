{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synoptic-ai/synoptic-runtime-config/runtime.schema.json",
  "title": "Synoptic runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retrieval_route_model",
    "p0_model",
    "p1_model",
    "p2_grounding_model",
    "p3_answer_model",
    "presentability_verifier_model",
    "compiler_model",
    "presentation_deck_planner_model",
    "retrieval_top_k",
    "p0_batch_size",
    "p0_concurrency",
    "p1_concurrency",
    "p1_quote_target_chars",
    "p1_summary_only_doc_threshold",
    "p1_summary_only_token_threshold",
    "p2_concurrency",
    "p2_grounding_batch_char_budget",
    "p3_input_char_budget",
    "default_window_days",
    "sync_dispatch_batch",
    "brief_active_days",
    "brief_dispatch_batch",
    "brief_local_hour",
    "brief_lease_minutes",
    "presentation_compile_concurrency",
    "presentation_lane_b_concurrency",
    "crm_detection_batch",
    "crm_detection_lease_minutes",
    "crm_detection_max_docs",
    "retrieval_enabled",
    "p1_bedrock_priority",
    "p0_enabled",
    "p0_bedrock_priority",
    "scheduler_enabled",
    "brief_scheduler_enabled",
    "rbac_enforce",
    "onboarding_kick",
    "crm_detection_enabled",
    "doc_viewer_users"
  ],
  "properties": {
    "retrieval_route_model": { "type": "string", "minLength": 1 },
    "p0_model": { "type": "string", "minLength": 1 },
    "p1_model": { "type": "string", "minLength": 1 },
    "p2_grounding_model": { "type": "string", "minLength": 1 },
    "p3_answer_model": { "type": "string", "minLength": 1 },
    "presentability_verifier_model": { "type": "string", "minLength": 1 },
    "compiler_model": { "type": "string", "minLength": 1 },
    "presentation_deck_planner_model": { "type": "string", "minLength": 1 },

    "retrieval_top_k": { "type": "integer", "minimum": 1 },
    "p0_batch_size": { "type": "integer", "minimum": 1 },
    "p0_concurrency": { "type": "integer", "minimum": 1 },
    "p1_concurrency": { "type": "integer", "minimum": 1 },
    "p1_quote_target_chars": { "type": "integer", "minimum": 1 },
    "p1_summary_only_doc_threshold": { "type": "integer", "minimum": 1 },
    "p1_summary_only_token_threshold": { "type": "integer", "minimum": 1 },
    "p2_concurrency": { "type": "integer", "minimum": 1 },
    "p2_grounding_batch_char_budget": { "type": "integer", "minimum": 1 },
    "p3_input_char_budget": { "type": "integer", "minimum": 1 },
    "default_window_days": { "type": "integer", "minimum": 1 },
    "sync_dispatch_batch": { "type": "integer", "minimum": 1 },
    "brief_active_days": { "type": "integer", "minimum": 1, "maximum": 90 },
    "brief_dispatch_batch": { "type": "integer", "minimum": 1 },
    "brief_local_hour": { "type": "integer", "minimum": 0, "maximum": 23 },
    "brief_lease_minutes": { "type": "integer", "minimum": 1 },
    "presentation_compile_concurrency": { "type": "integer", "minimum": 1 },
    "presentation_lane_b_concurrency": { "type": "integer", "minimum": 1 },
    "crm_detection_batch": { "type": "integer", "minimum": 1, "maximum": 10 },
    "crm_detection_lease_minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
    "crm_detection_max_docs": { "type": "integer", "minimum": 1 },

    "retrieval_enabled": { "type": "boolean" },
    "p1_bedrock_priority": { "type": "boolean" },
    "p0_enabled": { "type": "boolean" },
    "p0_bedrock_priority": { "type": "boolean" },
    "scheduler_enabled": { "type": "boolean" },
    "brief_scheduler_enabled": { "type": "boolean" },
    "rbac_enforce": { "type": "boolean" },
    "onboarding_kick": { "type": "boolean" },
    "crm_detection_enabled": { "type": "boolean" },
    "doc_viewer_users": { "type": "string", "maxLength": 0 }
  }
}
