{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/synoptic-ai/synoptic-runtime-config/runtime.schema.json",
  "title": "Synoptic runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "autocode_enabled_org_ids",
    "brief_active_days",
    "brief_dispatch_batch",
    "brief_lease_minutes",
    "brief_local_hour",
    "brief_scheduler_enabled",
    "chat_agent_model",
    "chat_max_concurrent_runs_per_org",
    "chat_max_concurrent_runs_per_user",
    "chat_max_run_minutes",
    "collection_carry_forward_max_chars",
    "collection_gate_churn_pct",
    "collection_gate_collapse_pct",
    "collection_gate_explosion_pct",
    "collection_gate_unjudged_pct",
    "collection_gate_unresolved_pct",
    "collection_lookback_days",
    "collection_map_concurrency",
    "collection_map_model",
    "collection_org_daily_cost_ceiling_usd",
    "collection_require_shared_authority",
    "collection_resolve_max_forms",
    "collection_resolve_model",
    "collection_retired_carry_max",
    "collection_run_cost_ceiling_usd",
    "compiler_model",
    "crm_detection_batch",
    "crm_detection_enabled",
    "crm_detection_lease_minutes",
    "crm_detection_max_docs",
    "default_window_days",
    "doc_viewer_users",
    "onboarding_kick",
    "p0_batch_size",
    "p0_bedrock_priority",
    "p0_concurrency",
    "p0_enabled",
    "p0_model",
    "p1_bedrock_priority",
    "p1_concurrency",
    "p1_model",
    "p1_quote_target_chars",
    "p1_summary_only_doc_threshold",
    "p1_summary_only_token_threshold",
    "p2_concurrency",
    "p2_grounding_batch_char_budget",
    "p2_grounding_model",
    "p2_merge_char_budget",
    "p2_merge_max_tokens",
    "p2_merge_model",
    "p2_merge_target_chars",
    "p2_merge_tree_k",
    "p3_answer_max_tokens",
    "p3_answer_model",
    "p3_input_char_budget",
    "presentability_verifier_model",
    "presentation_compile_concurrency",
    "presentation_deck_planner_model",
    "presentation_lane_b_concurrency",
    "rbac_enforce",
    "retrieval_enabled",
    "retrieval_route_model",
    "retrieval_top_k",
    "scheduler_enabled",
    "sync_dispatch_batch",
    "tree_build_orgs",
    "tree_hedge_ms",
    "tree_leaf_model",
    "tree_max_leaf_calls",
    "tree_retrieval_model",
    "tree_retrieval_orgs"
  ],
  "properties": {
    "retrieval_route_model": {
      "type": "string",
      "minLength": 1
    },
    "p0_model": {
      "type": "string",
      "minLength": 1
    },
    "p1_model": {
      "type": "string",
      "minLength": 1
    },
    "p2_grounding_model": {
      "type": "string",
      "minLength": 1
    },
    "p3_answer_model": {
      "type": "string",
      "minLength": 1
    },
    "presentability_verifier_model": {
      "type": "string",
      "minLength": 1
    },
    "compiler_model": {
      "type": "string",
      "minLength": 1
    },
    "presentation_deck_planner_model": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_top_k": {
      "type": "integer",
      "minimum": 1
    },
    "p0_batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "p0_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "p1_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "p1_quote_target_chars": {
      "type": "integer",
      "minimum": 1
    },
    "p1_summary_only_doc_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "p1_summary_only_token_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "p2_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "p2_grounding_batch_char_budget": {
      "type": "integer",
      "minimum": 1
    },
    "p3_input_char_budget": {
      "type": "integer",
      "minimum": 1
    },
    "default_window_days": {
      "type": "integer",
      "minimum": 1
    },
    "sync_dispatch_batch": {
      "type": "integer",
      "minimum": 1
    },
    "brief_active_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "brief_dispatch_batch": {
      "type": "integer",
      "minimum": 1
    },
    "brief_local_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "brief_lease_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "presentation_compile_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "presentation_lane_b_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "crm_detection_batch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "crm_detection_lease_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "crm_detection_max_docs": {
      "type": "integer",
      "minimum": 1
    },
    "retrieval_enabled": {
      "type": "boolean"
    },
    "p1_bedrock_priority": {
      "type": "boolean"
    },
    "p0_enabled": {
      "type": "boolean"
    },
    "p0_bedrock_priority": {
      "type": "boolean"
    },
    "scheduler_enabled": {
      "type": "boolean"
    },
    "brief_scheduler_enabled": {
      "type": "boolean"
    },
    "rbac_enforce": {
      "type": "boolean"
    },
    "onboarding_kick": {
      "type": "boolean"
    },
    "crm_detection_enabled": {
      "type": "boolean"
    },
    "doc_viewer_users": {
      "type": "string",
      "maxLength": 0
    },
    "p2_merge_model": {
      "type": "string",
      "minLength": 1
    },
    "p2_merge_tree_k": {
      "type": "integer",
      "minimum": 1
    },
    "p2_merge_target_chars": {
      "type": "integer",
      "minimum": 1
    },
    "p2_merge_char_budget": {
      "type": "integer",
      "minimum": 1
    },
    "p2_merge_max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "p3_answer_max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "collection_map_model": {
      "type": "string",
      "minLength": 1
    },
    "collection_resolve_model": {
      "type": "string",
      "minLength": 1
    },
    "collection_lookback_days": {
      "type": "integer",
      "minimum": 1
    },
    "collection_map_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "collection_resolve_max_forms": {
      "type": "integer",
      "minimum": 1
    },
    "collection_carry_forward_max_chars": {
      "type": "integer",
      "minimum": 1
    },
    "collection_retired_carry_max": {
      "type": "integer",
      "minimum": 0
    },
    "collection_require_shared_authority": {
      "type": "integer",
      "minimum": 0
    },
    "collection_run_cost_ceiling_usd": {
      "type": "integer",
      "minimum": 0
    },
    "collection_org_daily_cost_ceiling_usd": {
      "type": "integer",
      "minimum": 0
    },
    "collection_gate_unjudged_pct": {
      "type": "integer",
      "minimum": 0
    },
    "collection_gate_unresolved_pct": {
      "type": "integer",
      "minimum": 0
    },
    "collection_gate_collapse_pct": {
      "type": "integer",
      "minimum": 0
    },
    "collection_gate_explosion_pct": {
      "type": "integer",
      "minimum": 0
    },
    "collection_gate_churn_pct": {
      "type": "integer",
      "minimum": 0
    },
    "chat_agent_model": {
      "type": "string",
      "minLength": 1
    },
    "chat_max_concurrent_runs_per_user": {
      "type": "integer",
      "minimum": 1
    },
    "chat_max_concurrent_runs_per_org": {
      "type": "integer",
      "minimum": 1
    },
    "chat_max_run_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "autocode_enabled_org_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tree_retrieval_orgs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Org ids routed through tree-of-summaries descent (SYN-587). Empty = feature off."
    },
    "tree_hedge_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Hedged-request threshold for tree descent calls, ms (SYN-587)."
    },
    "tree_leaf_model": {
      "type": "string",
      "minLength": 1,
      "description": "Model for tree-descent leaf extraction (SYN-587). Benchmarked flash-lite exception."
    },
    "tree_retrieval_model": {
      "type": "string",
      "minLength": 1,
      "description": "Model for tree-descent scans L0/L1 (SYN-587)."
    },
    "tree_build_orgs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Orgs whose ingest pre-builds doc trees (SYN-587); building may lead routing."
    },
    "tree_max_leaf_calls": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-query ceiling on tree leaf extraction calls (SYN-587); excess docs fall back, counted leaf_capped."
    }
  }
}
